---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/content', label: 'Content' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!-- Real button-sized targets: a full-width row of five on phones (40 px tall), a row of buttons on the right on
     wider screens. The current page is filled in. -->
<header class="sticky top-0 z-50 border-b border-border bg-bg/95 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-2.5 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-3">
    <a href="/" class="py-1 font-mono-tight text-sm font-medium text-fg sm:text-base">
      ARNAB<span class="text-accent">_</span>MAJUMDER
    </a>
    <ul class="grid grid-cols-5 gap-1.5 font-mono-tight text-[11px] uppercase tracking-wider sm:flex sm:gap-2 sm:text-sm">
      {links.map((link) => {
        const active = path === link.href || path.startsWith(`${link.href}/`);
        return (
          <li>
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex min-h-10 items-center justify-center border px-1 transition-colors sm:px-4',
                active
                  ? 'border-accent bg-accent text-bg'
                  : 'border-border-strong bg-bg-elevated text-fg hover:border-accent hover:text-accent',
              ]}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
