---
interface Props {
  label: string;
  value: string;
  detail?: string;
}
const { label, value, detail } = Astro.props;
---

<div class="border border-border bg-bg-elevated px-5 py-4">
  <p class="font-mono-tight text-[11px] uppercase tracking-wider text-fg-dim">{label}</p>
  <p class="mt-2 font-mono-tight text-2xl font-semibold text-accent">{value}</p>
  {detail && <p class="mt-1 text-sm text-fg-muted">{detail}</p>}
</div>
