---
import MediaSlot from './MediaSlot.astro';
import Tag from './Tag.astro';
import Highlights from './Highlights.astro';

interface Props {
  slug: string;
  title: string;
  kicker: string;
  tagline: string;
  tags: string[];
  status: string;
  coverLabel: string;
  coverSrc?: string;
  coverKind?: 'image' | 'video';
  coverFit?: 'cover' | 'contain';
  highlights?: { value: string; label: string }[];
  compact?: boolean;
  demo?: { label: string; href: string };
}

const {
  slug,
  title,
  kicker,
  tagline,
  tags,
  status,
  coverLabel,
  coverSrc,
  coverKind = 'image',
  coverFit = 'cover',
  highlights = [],
  compact = false,
  demo,
} = Astro.props;
---

<!-- The title link stretches over the whole card (after:inset-0), so the whole card is clickable while the demo
     button, layered above it, stays a separate link. -->
<article class="group relative flex h-full flex-col border border-border bg-bg-elevated transition-colors hover:border-border-strong">
  {coverSrc ? (
  <div class="relative">
    <MediaSlot
      label={coverLabel}
      src={coverSrc}
      kind={coverKind}
      fit={coverFit}
      controls={false}
      aspect={compact ? 'aspect-[16/9]' : 'aspect-video'}
      class="rounded-none border-0 border-b border-border"
    />
    <span class="status-stamp absolute left-3 top-3 max-w-[85%] bg-bg/90 font-mono-tight text-[10px] uppercase tracking-wider">
      {status}
    </span>
  </div>
  ) : (
    <div class="border-b border-border px-5 pt-5">
      <span class="status-stamp mb-4 font-mono-tight text-[10px] uppercase tracking-wider">{status}</span>
    </div>
  )}
  <div class:list={['flex flex-1 flex-col p-5', compact && 'p-4']}>
    <p class="font-mono-tight text-[11px] uppercase tracking-wider text-fg-dim">{kicker}</p>
    <h3 class:list={['mt-2 font-serif font-medium text-fg group-hover:text-accent', compact ? 'text-lg' : 'text-xl']}>
      <a href={`/projects/${slug}`} class="after:absolute after:inset-0 after:content-['']">{title}</a>
    </h3>
    <p class="mt-2 text-sm text-fg-muted">{tagline}</p>
    {
      highlights.length > 0 && (
        <div class="mt-4 border-t border-border pt-4">
          <Highlights items={highlights} variant="inline" max={2} />
        </div>
      )
    }
    <div class="mt-auto flex flex-wrap gap-2 pt-4">
      {tags.slice(0, compact ? 3 : 4).map((t) => <Tag>{t}</Tag>)}
    </div>
    {
      demo && (
        <a
          href={demo.href}
          class="relative z-10 mt-4 inline-flex items-center gap-2 self-start border border-accent bg-accent px-4 py-2 font-mono-tight text-xs uppercase tracking-wider text-bg transition-opacity hover:opacity-90"
        >
          {demo.label} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>
