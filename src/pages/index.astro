---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectGroups from '../components/ProjectGroups.astro';
import StatReadout from '../components/StatReadout.astro';
import MediaSlot from '../components/MediaSlot.astro';

const published = await getCollection('projects', ({ data }) => !data.draft);
const live = new Set(published.map((p) => `/projects/${p.id}`));

// Every line here must match the resume and the confirmed facts in ~/WorkFiles/Resumes/CLAUDE.md.
const experience = [
  {
    role: 'Controls & Embedded Systems Engineer (Full-Time)',
    org: 'Aston Dynamics',
    dates: 'Mar 2025 – Present',
    line: 'The control loop, sway controller, state estimation and test tooling inside the TowPilot and Delta trailer brake controllers, plus all the electronics and firmware for a battery-powered Bluetooth product.',
    links: [
      { label: 'Brake controller', href: '/projects/stability-control' },
      { label: 'Simulation', href: '/projects/vehicle-simulation' },
      { label: 'BLE product', href: '/projects/embedded-product' },
    ],
  },
  {
    role: 'Systems Integration Engineer',
    org: 'UofT Aerospace Team, Unmanned Aircraft Systems',
    dates: 'Sep 2023 – Mar 2025',
    line: 'An antenna-tracking ground station that cut flyby link dropouts 8×, the PX4–ROS integration on the drone, and its video pipeline.',
    links: [
      { label: 'Antenna turret', href: '/projects/antenna-tracker' },
      { label: 'Video pipeline', href: '/projects/uav-video-streaming' },
    ],
  },
  {
    role: 'ESROP Global Research Intern',
    org: 'KMUTT IC2 Lab, Bangkok',
    dates: 'May 2024 – Aug 2024',
    line: 'An adaptive EKF for IMU pose estimation that drifted 32% less than a standard EKF.',
    links: [{ label: 'Research', href: '/projects/esrop-internship' }],
  },
  {
    role: 'Team Captain, then Mentor',
    org: 'FIRST Robotics Competition',
    dates: 'Nov 2021 – Jun 2025',
    line: 'Electrical design, motors and PID tuning; the team’s first competition win in 8 years.',
    links: [{ label: 'FRC', href: '/projects/frc' }],
  },
].map((e) => ({ ...e, links: e.links.filter((l) => live.has(l.href)) }));

const skills = [
  { group: 'Controls & estimation', items: ['MPC', 'PID', 'EKF / UKF', 'Sensor fusion', 'Vehicle dynamics', 'Multibody simulation'] },
  { group: 'Embedded', items: ['Rust', 'C / MISRA C', 'C++', 'FreeRTOS', 'ESP-IDF', 'SPI · UART · I2C · CAN', 'BLE (GATT)', 'OTA updates'] },
  { group: 'Robotics & simulation', items: ['ROS / ROS 2', 'micro-ROS', 'PX4', 'Gazebo', 'Simulink', 'SIL / HIL testing'] },
  { group: 'Hardware & data', items: ['KiCad schematic + PCB', 'Board bring-up', 'Oscilloscope', 'Onshape CAD', 'Python', 'PyTorch · XGBoost'] },
];
---

<Layout title="Arnab Majumder">
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 pb-10 pt-12 sm:px-6 sm:pb-14 sm:pt-20">
    <div class="grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_16rem]">
      <div>
        <p class="font-mono-tight text-sm uppercase tracking-wider text-accent">Arnab Majumder</p>
        <div class="contour-rule mt-2"></div>
        <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold leading-tight text-fg sm:text-5xl">
          I build control systems that run on real vehicles.
        </h1>
        <p class="mt-5 max-w-2xl text-base text-fg-muted sm:text-lg">
          Controls &amp; Embedded Systems Engineer at Aston Dynamics, where I write the control loop and the patent-pending
          sway controller inside the TowPilot and Delta trailer brake controllers. Robotics Engineering at the University
          of Toronto.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#projects" class="border border-accent bg-accent px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-bg transition-opacity hover:opacity-90">
            View projects
          </a>
          <a href="/resume" class="border border-border-strong px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-fg transition-colors hover:border-accent hover:text-accent">
            Resume
          </a>
          <a href="/sway-demo" class="border border-border-strong px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-fg transition-colors hover:border-accent hover:text-accent">
            Try the sway demo
          </a>
          <a href="/content" class="border border-border-strong px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-fg transition-colors hover:border-accent hover:text-accent">
            Beyond engineering
          </a>
          <a href="/contact" class="border border-border-strong px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-fg transition-colors hover:border-accent hover:text-accent">
            Contact
          </a>
        </div>
      </div>
      <div class="mx-auto w-40 sm:w-48 md:w-full">
        <MediaSlot label="Arnab Majumder" src="/media/about/headshot.jpg" aspect="aspect-square" class="rotate-[1deg]" />
      </div>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      <StatReadout label="Trailer sway damping" value="+45%" detail="vs. the top competitor (ζ 0.80 vs 0.55), steering-impulse tests at 70–140 km/h" />
      <StatReadout label="Sway detection" value="100% recall" detail="at 98% precision over 100+ sway events" />
      <StatReadout label="In customer beta" value="2 products" detail="a trailer brake controller in 4 countries, and a 30-unit Bluetooth product" />
    </div>
  </section>

  <!-- Projects with a photo or video, grouped (the Projects page has all of them) -->
  <section id="projects" class="mx-auto max-w-6xl scroll-mt-28 px-4 py-12 sm:px-6">
    <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">Projects</h2>
    <div class="contour-rule mt-2"></div>
    <ProjectGroups headingLevel="h3" mediaOnly />
  </section>

  <!-- Experience -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">Experience</h2>
    <div class="contour-rule mt-2"></div>
    <ol class="mt-6 border-l border-border-strong">
      {experience.map((e) => (
        <li class="relative pb-8 pl-6 last:pb-0">
          <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full border border-accent bg-bg"></span>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <h3 class="font-serif text-lg font-medium text-fg">{e.role}</h3>
            <p class="shrink-0 font-mono-tight text-xs uppercase tracking-wider text-fg-dim">{e.dates}</p>
          </div>
          <p class="text-sm font-medium text-fg-muted">{e.org}</p>
          <p class="mt-2 max-w-3xl text-sm text-fg-muted">{e.line}</p>
          <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
            {e.links.map((l) => (
              <a href={l.href} class="font-mono-tight text-xs text-accent hover:underline">{l.label} →</a>
            ))}
          </p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Skills -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">Skills</h2>
    <div class="contour-rule mt-2"></div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {skills.map((s) => (
        <div>
          <h3 class="text-sm font-semibold text-fg">{s.group}</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {s.items.map((i) => (
              <li class="rounded-sm border border-border bg-bg-elevated px-2 py-1 font-mono-tight text-[11px] text-fg-muted">{i}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- About teaser -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="border border-border bg-bg-elevated p-6 sm:p-10">
      <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">About</h2>
      <div class="contour-rule mt-2"></div>
      <p class="mt-3 max-w-2xl text-fg-muted">
        I have one year left in Robotics Engineering at the University of Toronto, and I'm taking a gap year to
        work full-time at Aston Dynamics. I like engineering where software has to deal with the physical world,
        and taking a system from a first model to something that runs outside a lab. Outside of work, I travel a
        lot: 33 countries so far.
      </p>
      <a href="/about" class="mt-4 inline-block font-mono-tight text-sm text-accent hover:underline">More about me →</a>
    </div>
  </section>
</Layout>
