---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import StatReadout from '../components/StatReadout.astro';
import MediaSlot from '../components/MediaSlot.astro';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Arnab Majumder">
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pb-16 pt-20 sm:pt-28">
    <p class="font-mono-tight text-sm uppercase tracking-wider text-accent">Arnab Majumder</p>
    <div class="contour-rule mt-2"></div>
    <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold leading-tight text-fg sm:text-6xl">
      Robotics / Controls / Embedded Systems
    </h1>
    <p class="mt-6 max-w-2xl font-mono-tight text-xl text-fg-muted sm:text-2xl">I build physical systems.</p>
    <p class="mt-6 max-w-2xl text-base text-fg-muted sm:text-lg">
      Controls, embedded firmware, and electronics. I work through the whole stack from a model on paper to
      hardware running on a vehicle in the field. University of Toronto Engineering Science, Robotics Engineering.
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/projects" class="border border-accent bg-accent px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-bg transition-opacity hover:opacity-90">
        View Projects
      </a>
      <a href="/resume" class="border border-border-strong px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-fg transition-colors hover:border-accent hover:text-accent">
        Resume
      </a>
      <a href="https://github.com/arnabmaj24" target="_blank" rel="noreferrer" class="border border-border-strong px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-fg transition-colors hover:border-accent hover:text-accent">
        GitHub
      </a>
      <a href="/contact" class="border border-border-strong px-5 py-2.5 font-mono-tight text-sm uppercase tracking-wider text-fg transition-colors hover:border-accent hover:text-accent">
        Contact
      </a>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="mx-auto max-w-6xl px-6 py-14">
    <div class="flex items-baseline justify-between">
      <div>
        <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">Featured work</h2>
        <div class="contour-rule mt-2"></div>
      </div>
      <a href="/projects" class="font-mono-tight text-xs uppercase tracking-wider text-fg-muted hover:text-accent">All projects →</a>
    </div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {featured.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          kicker={project.data.kicker}
          tagline={project.data.tagline}
          tags={project.data.tags}
          status={project.data.status}
          coverLabel={project.data.coverLabel}
          coverSrc={project.data.coverSrc}
          coverKind={project.data.coverKind}
          confidential={project.data.confidential}
        />
      ))}
    </div>
  </section>

  <!-- Proof strip -->
  <section class="mx-auto max-w-6xl px-6 py-14">
    <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">In the field, not just in simulation</h2>
    <div class="contour-rule mt-2"></div>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <StatReadout label="Vehicle stability system" value="Field-validated" detail="Full-scale testing in Australia" />
      <StatReadout label="Embedded hardware product" value="~5,000 units/yr" detail="Planned production, currently in beta" />
      <StatReadout label="Autonomous drone" value="24 hours" detail="Concept to indoor autonomous flight, MakeUofT hackathon" />
    </div>
  </section>

  <!-- About teaser -->
  <section class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-8 border border-border bg-bg-elevated p-8 sm:grid-cols-2 sm:p-10">
      <div>
        <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">About</h2>
        <div class="contour-rule mt-2"></div>
        <p class="mt-3 max-w-xl text-fg-muted">
          I'm a Robotics Engineering student at the University of Toronto, and a Controls & Embedded Systems
          Engineer at Aston Dynamics, where I work across control systems, firmware, and electronics. I like
          engineering where software actually has to deal with the physical world, and I like taking a system
          the whole way from a first model to something that runs outside a lab.
        </p>
        <a href="/about" class="mt-4 inline-block font-mono-tight text-sm text-accent hover:underline">More about me →</a>
      </div>
      <div class="border-t border-border pt-6 sm:border-l sm:border-t-0 sm:pl-8 sm:pt-0">
        <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">Beyond engineering</h2>
        <div class="contour-rule mt-2"></div>
        <div class="mt-4 max-w-sm">
          <MediaSlot label="The Alps" src="/media/travel/alps-ridge.jpg" aspect="aspect-[4/3]" class="rotate-[-0.75deg]" />
        </div>
        <p class="mt-4 text-sm text-fg-muted">
          I'm also a full-time engineering student who travels a lot: over 100 days abroad so far while studying
          and working. I make short-form content about it as{' '}
          <a href="https://www.instagram.com/arnabsalive/" target="_blank" rel="noreferrer" class="text-accent hover:underline">@arnabsalive</a>,
          reaching 1M+ views a month.
        </p>
      </div>
    </div>
  </section>
</Layout>
