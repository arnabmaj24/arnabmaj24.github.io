---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectGroups from '../../components/ProjectGroups.astro';
import { GROUPS } from '../../lib/projectGroups';

const projects = await getCollection('projects', ({ data }) => !data.draft);
---

<Layout title="Projects" description="Controls, embedded and robotics projects: trailer sway control, vehicle simulation, embedded products, drones and rockets.">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
    <p class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">Projects</p>
    <div class="contour-rule mt-2"></div>
    <h1 class="mt-4 font-serif text-3xl font-semibold text-fg sm:text-4xl">Things I've built</h1>
    <nav aria-label="Project groups" class="mt-5 flex flex-wrap gap-2">
      {GROUPS.map((g) => {
        const n = projects.filter((p) => p.data.group === g.key).length;
        return n > 0 && (
          <a href={`#${g.key}`} class="rounded-sm border border-border-strong px-3 py-1.5 font-mono-tight text-xs uppercase tracking-wider text-fg-muted hover:border-accent hover:text-accent">
            {g.title} <span class="text-fg-dim">({n})</span>
          </a>
        );
      })}
    </nav>

    <div class="mt-8">
      <ProjectGroups />
    </div>
  </section>
</Layout>
