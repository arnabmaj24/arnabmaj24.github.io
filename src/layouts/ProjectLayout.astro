---
import Layout from './Layout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import Tag from '../components/Tag.astro';

interface Props {
  title: string;
  kicker: string;
  tagline: string;
  summary: string;
  status: string;
  year: string;
  stack: string[];
  tags: string[];
  role: string[];
  links: { label: string; href: string }[];
  confidential: boolean;
  size: 'full' | 'compact';
  coverLabel: string;
  coverSrc?: string;
  coverKind?: 'image' | 'video';
}

const {
  title,
  kicker,
  tagline,
  summary,
  status,
  year,
  stack,
  role,
  links,
  confidential,
  size,
  coverLabel,
  coverSrc,
  coverKind = 'image',
} = Astro.props;
---

<Layout title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-6 py-14">
    <a href="/projects" class="font-mono-tight text-xs uppercase tracking-wider text-fg-muted hover:text-accent">
      ← All projects
    </a>

    <p class="mt-6 font-mono-tight text-xs uppercase tracking-wider text-fg-dim">{kicker}</p>
    <h1 class="mt-2 font-serif text-3xl font-semibold text-fg sm:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-fg-muted">{tagline}</p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <span class="status-stamp font-mono-tight text-xs uppercase tracking-wider">{status}</span>
      <span class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">{year}</span>
    </div>

    <div class="mt-10">
      <MediaSlot label={coverLabel} src={coverSrc} kind={coverKind} aspect={size === 'full' ? 'aspect-video' : 'aspect-[16/9]'} />
    </div>

    {
      confidential && (
        <div class="mt-8 border border-border bg-bg-elevated px-5 py-4">
          <p class="font-mono-tight text-[11px] uppercase tracking-wider text-fg-dim">// Note</p>
          <p class="mt-2 text-sm text-fg-muted">
            This work was done for an employer and involves patent-pending, safety-critical technology. Some details
            are intentionally generalized. Diagrams and specifics that would expose proprietary implementation are
            left out.
          </p>
        </div>
      )
    }

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">My role</h2>
        <ul class="mt-3 space-y-2">
          {role.map((r) => (
            <li class="flex gap-2 text-sm text-fg-muted">
              <span class="text-accent">›</span>
              {r}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">Stack</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {stack.map((s) => <Tag>{s}</Tag>)}
        </div>
      </div>
    </div>

    <div class="prose prose-headings:font-medium prose-headings:text-fg prose-p:text-fg-muted prose-li:text-fg-muted prose-strong:text-fg mt-12 max-w-none prose-headings:mt-10 prose-headings:mb-3 prose-h2:text-xl">
      <slot />
    </div>

    {
      links.length > 0 && (
        <div class="mt-12 border-t border-border pt-8">
          <h2 class="font-mono-tight text-xs uppercase tracking-wider text-fg-dim">Links</h2>
          <ul class="mt-3 flex flex-wrap gap-4">
            {links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noreferrer" class="text-sm text-accent hover:underline">
                  {l.label} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
</Layout>
